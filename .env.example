# Copy to .env locally and fill in private values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-with-a-long-unique-password
COOKIE_SECURE=0

# Option A: any tested OpenAI-compatible chat-completions endpoint.
# The base URL must include the API prefix expected by that vendor.
# OpenAI example:
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Option B: Mistral Agent API (requires both values).
MISTRAL_API_KEY=
MISTRAL_AGENT_ID=

# Other vendors may work through AI_BASE_URL only when their endpoint,
# model, authentication and response_format behavior are compatible.
# Do not assume a vendor is supported until its adapter/contract tests pass.
# ChatGPT account access is NOT an OpenAI API key. ChatGPT app/MCP integration
# is a separate authenticated server component; see docs/AI_CONNECTORS.md.

# Protect business API routes with login and CSRF (recommended).
REQUIRE_API_AUTH=1
