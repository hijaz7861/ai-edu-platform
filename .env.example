# Copy to .env locally and fill in private values. Never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-with-a-long-unique-password
COOKIE_SECURE=0

# Optional native Gemini provider:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Optional OpenAI-compatible provider. For Mistral API, use:
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_MODEL=<model-supported-by-your-Mistral-account>
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional Mistral Agent provider (distinct from the Mistral chat-completions API):
MISTRAL_API_KEY=
MISTRAL_AGENT_ID=

# Optional explicit provider selection. Leave blank to auto-select the first
# configured real provider (Mistral Agent, Gemini, then OpenAI-compatible).
# Use stub-offline-v1 only when deterministic offline behavior is intended.
AI_PROVIDER=

# Protect business API routes with login and CSRF (recommended).
REQUIRE_API_AUTH=1

# For production set APP_ENV=production and COOKIE_SECURE=1; the app forces
# secure cookies in production and refuses missing SECRET_KEY/admin credentials.
