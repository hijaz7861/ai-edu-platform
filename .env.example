# Copy to .env locally and fill in private values. Never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-with-a-long-unique-password
COOKIE_SECURE=0

# Optional native Gemini provider:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Optional OpenAI-compatible provider. For Mistral chat-completions, use:
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_MODEL=<model-supported-by-your-Mistral-account>
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional Mistral Agent API (requires both values; distinct from Mistral chat-completions):
MISTRAL_API_KEY=
MISTRAL_AGENT_ID=

# Optional explicit provider selection. Leave blank to auto-select the first
# configured real provider (Mistral Agent, Gemini, then OpenAI-compatible).
# Use stub-offline-v1 only when deterministic offline behavior is intended.
AI_PROVIDER=

# Other vendors may work through AI_BASE_URL only when endpoint, model,
# authentication, and response_format behavior are compatible. Do not assume
# a vendor is supported until adapter/contract tests pass.
# ChatGPT account access is NOT an OpenAI API key. A ChatGPT app/MCP integration
# is a separate authenticated server component; see docs/AI_CONNECTORS.md.

# Protect business API routes with login and CSRF.
REQUIRE_API_AUTH=1
# Enable feature entitlement gates in staging; production enforces them automatically.
ENFORCE_ENTITLEMENTS=0
# Production API rate limit per endpoint/client per minute; staging opt-in below.
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_ENABLED=0

# For production set APP_ENV=production and COOKIE_SECURE=1; the app forces
# secure cookies in production and refuses missing SECRET_KEY/admin credentials.
